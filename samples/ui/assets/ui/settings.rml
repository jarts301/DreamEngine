<rml>
<head>
    <title>Settings</title>
    <link type="text/rcss" href="style.rcss"/>
</head>
<body class="cover">
    <div class="panel">
        <h1>Settings</h1>
        <div class="row">
            <label>Music</label><input id="music" type="range" min="0" max="1" step="0.05" value="0.6"/><span class="amount" id="music_amount">60%</span>
        </div>
        <div class="row">
            <label>Effects</label><input id="effects" type="range" min="0" max="1" step="0.05" value="0.8"/><span class="amount" id="effects_amount">80%</span>
        </div>
        <div class="row">
            <input id="show_timer" type="checkbox" checked=""/><label class="wide">Show the timer</label>
        </div>
        <div class="row">
            <input id="vibration" type="checkbox"/><label class="wide">Vibration</label>
        </div>
        <button id="back">Back</button>
    </div>
</body>
</rml>
