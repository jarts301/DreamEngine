# The checks' configuration, made into one per graphics backend by dream_add_feature_sample.
[app]
window = "hidden"
title = "Dream Input Check"
width = 960
height = 540
max_fps = 0

[demo]
quit_after_frames = @QUIT_AFTER@

[input.actions]
move_left = ["key:a"]
move_right = ["key:d"]
move_up = ["key:w"]
move_down = ["key:s"]
jump = ["key:space"]
boost = ["key:left_shift"]
brake = ["key:left_control"]
touch = ["mouse:left"]
quit = ["key:escape"]

@RHI_TABLE@

@SCREENSHOT@

[modules.windows]
platform = ["sdl3"]
input_device = ["null"]
rhi = ["@RHI@"]
renderer = ["forward_plus"]
ui = ["rmlui"]
texture_decoder = ["ktx", "null"]

[modules.android]
platform = ["sdl3"]
input_device = ["null"]
rhi = ["@RHI@"]
renderer = ["forward_plus"]
ui = ["rmlui"]
texture_decoder = ["ktx", "null"]

[modules.linux]
platform = ["sdl3"]
input_device = ["null"]
rhi = ["@RHI@"]
renderer = ["forward_plus"]
ui = ["rmlui"]
texture_decoder = ["ktx", "null"]

[audio]
muted = true
