<rml>
<head>
    <title>Menu</title>
    <link type="text/rcss" href="style.rcss"/>
</head>
<body class="menu">
    <div class="panel">
        <h1>Paused</h1>
        <button id="resume">Resume</button>
        <button id="restart">Restart</button>
        <div class="row">
            <label>Music</label><input id="music" type="range" min="0" max="1" step="0.05" value="0.6"/>
        </div>
        <div class="row">
            <label>Effects</label><input id="effects" type="range" min="0" max="1" step="0.05" value="1"/>
        </div>
        <div class="row">
            <input id="debug" type="checkbox"/><label class="wide">Debug tools</label>
        </div>
    </div>
</body>
</rml>
