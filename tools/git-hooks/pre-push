#!/bin/sh
# Refuses to push the offline-web branch into main (or master) on any remote.
check="$(git rev-parse --git-common-dir)/hooks/never_merge_offline_web.sh"
zero=0000000000000000000000000000000000000000
status=0
while read -r local_ref local_sha remote_ref remote_sha; do
    case "$remote_ref" in
        refs/heads/main | refs/heads/master) ;;
        *) continue ;;
    esac
    [ "$local_sha" = "$zero" ] && continue
    if sh "$check" "$local_sha"; then
        echo "error: refusing to push offline-web into ${remote_ref#refs/heads/} on $1." >&2
        status=1
    fi
done
exit $status
