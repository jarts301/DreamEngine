#!/bin/sh
# Refuses to move main (or master) onto a commit that holds the offline-web branch, however it
# would get there: merge, fast-forward, pull, reset, rebase or update-ref. See OFFLINE_WEB_BRANCH.md
# on that branch.
[ "$1" = "prepared" ] || exit 0
check="$(git rev-parse --git-common-dir)/hooks/never_merge_offline_web.sh"
zero=0000000000000000000000000000000000000000
status=0
while read -r old new ref; do
    case "$ref" in
        refs/heads/main | refs/heads/master) ;;
        *) continue ;;
    esac
    [ "$new" = "$zero" ] && continue
    if sh "$check" "$new"; then
        echo "error: offline-web must never be merged into ${ref#refs/heads/}; nothing was changed." >&2
        echo "       Merge main into offline-web, or cherry-pick single commits, instead." >&2
        status=1
    fi
done
exit $status
